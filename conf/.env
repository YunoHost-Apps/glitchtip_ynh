SECRET_KEY=__SECRET_KEY__
EMAIL_URL="smtp://__APP__:__MAIL_PWD__@localhost:587"
DEFAULT_FROM_EMAIL=__APP__@__DOMAIN__
GLITCHTIP_DOMAIN=__DOMAIN__
DATABASE_URL=postgresql://__DB_USER__:__DB_PWD__@localhost/__DB_NAME__
BASE_PATH=__PATH__
PROXY_ENV=true
GLITCHTIP_ENABLE_DUCKDB=true
GLITCHTIP_COLD_STORAGE_DIR=/var/yunohost.app/__APP__
GLITCHTIP_ENABLE_LOGS=true
PORT=__PORT__